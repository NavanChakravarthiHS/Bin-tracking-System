# ============================================================
# EcoTrack Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# --- Database (required) ---
# Local dev:
# MONGODB_URI=mongodb://127.0.0.1:27017/ecotrack_admin
# Production — MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecotrack_admin?retryWrites=true&w=majority

# --- Auth (required) ---
# Use a strong random string (min 32 chars) in production.
JWT_SECRET=your_jwt_secret_here

# --- Seeding ---
SEED_DEFAULT_ADMIN=true

# --- CORS ---
# Comma-separated list of allowed browser origins, no trailing slash.
# Example: https://ecotrack-admin.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Blynk IoT (optional) ---
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here
BLYNK_API_URL=https://blynk.cloud/external/api

# --- TextBee SMS Gateway (optional — https://textbee.dev) ---
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
DEFAULT_COUNTRY_CODE=+91

# --- Vercel Cron Security (optional but recommended in production) ---
# Protects GET /internal/sync-sensors from unauthorized callers.
CRON_SECRET=your_cron_secret_here

# ============================================================
# NodeMCU / IoT Sensor — POST formats:
#   POST {BACKEND_URL}/admin/bins/{BIN_ID}/sensor
#   POST {BACKEND_URL}/iot/bins/{BIN_ID}/sensor
#   POST {BACKEND_URL}/iot/sensor
#
# JSON body:
#   { "distance": 22, "fillPercentage": 70 }
#   { "binId": "BIN001", "distance": 22 }
#
# These endpoints are public (no auth required).
# ============================================================
