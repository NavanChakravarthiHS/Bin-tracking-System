# ============================================================
# EcoTrack Frontend — Environment Variables (Vite)
# Copy this file to .env and fill in your values.
# Only VITE_ prefixed variables are exposed to the browser.
# NEVER put JWT secrets, DB passwords, or SMS credentials here.
# ============================================================

# Production backend URL — no trailing slash.
# Example: https://ecotrack-api.vercel.app
# Leave empty for local dev (Vite proxy handles /admin, /collector, /iot, /health)
VITE_API_BASE_URL=

# Optional — required only if you use the Google Maps component.
# Get a key at: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=

# Optional — override the backend proxy target during local development.
# Defaults to http://localhost:5000
# VITE_DEV_BACKEND_URL=http://localhost:5000
